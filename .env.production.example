# ─────────────────────────────────────────────────────────────────────
# SEVALINK / TrustNear — PRODUCTION env template
#
# This file is COMMITTED to git as a template. Actual production values
# live in:
#   - AWS App Runner env vars (for the API service)
#   - GitHub repo secrets (for CI/CD)
#   - AWS Systems Manager Parameter Store / Secrets Manager (for rotation)
#
# DO NOT put real secrets here. DO NOT copy this to .env.production
# and commit — that file is gitignored.
#
# To set up production:
#   1. Copy this file → .env.production (locally, never commit)
#   2. Fill in real values from each provider
#   3. Use those values when configuring App Runner / GitHub secrets
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ─── Database: Neon Postgres (production project, separate from dev) ───
# Create a NEW Neon project (not dev). Same region: ap-southeast-1.
# Pooler URL for runtime; direct URL for prisma migrate deploy.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─── Redis: Upstash (production instance, separate from dev) ───
# Create a NEW Upstash Redis database in ap-southeast-1.
# Note rediss:// (double s) for TLS — Node ioredis client auto-detects.
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# ─── Auth — rotate before every prod release if compromised ───
# Generate 256-bit random hex: `openssl rand -hex 32`
# Use TWO DIFFERENT secrets — access vs refresh.
JWT_SECRET="<256-bit hex — generate with openssl rand -hex 32>"
JWT_REFRESH_SECRET="<256-bit hex — DIFFERENT from JWT_SECRET>"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ─── SMS / OTP (MSG91 — production keys, DLT-approved templates) ───
# Get from MSG91 dashboard AFTER DLT registration is approved.
# MSG91_TEMPLATE_ID must match an approved DLT template on TRAI portal.
MSG91_AUTH_KEY="<prod auth key>"
MSG91_TEMPLATE_ID="<approved DLT template ID>"
MSG91_SENDER_ID="TRUSNR"

# ─── Google Maps Platform — separate key for prod (lockdown to api.trustnear.in) ───
# Create a new API key in GCP, restrict by HTTP referer + Android package.
GOOGLE_MAPS_API_KEY="<prod key — referrer-restricted>"

# ─── Payments: Cashfree (production — after KYC approval) ───
# Get from Cashfree merchant dashboard once business KYC is approved.
PAYMENT_PROVIDER="cashfree"
CASHFREE_ENV="production"
CASHFREE_APP_ID="<prod app ID>"
CASHFREE_SECRET_KEY="<prod secret>"
CASHFREE_WEBHOOK_SECRET="<set in Cashfree dashboard, paste here>"

# Razorpay kept as failover. Leave blank if not using.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── AWS (Mumbai) — for S3 media + CloudFront + Rekognition ───
# Use an IAM user with LEAST-PRIVILEGE policy:
#   s3:PutObject + GetObject on trustnear-media-prod
#   cloudfront:CreateInvalidation on the dist
#   rekognition:DetectFaces (KYC face match)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="<sevalink-api-runtime IAM user key>"
AWS_SECRET_ACCESS_KEY="<sevalink-api-runtime IAM user secret>"
S3_BUCKET_MEDIA="trustnear-media-prod"
CLOUDFRONT_DOMAIN="media.trustnear.in"

# ─── Firebase (FCM) — production project ───
# Create a NEW Firebase project for production (not dev).
# Upload the service account JSON to AWS Secrets Manager + mount at boot.
FIREBASE_SERVICE_ACCOUNT_PATH="/run/secrets/firebase-prod-sa.json"

# ─── Setu — KYC Verification (production track — after KYC_SOLE_PROP approval) ───
SETU_ENV="production"
SETU_BASE_URL="https://api.setu.co"
SETU_CLIENT_ID="<prod client ID>"
SETU_CLIENT_SECRET="<prod secret>"
SETU_PRODUCT_INSTANCE_ID="<prod instance ID>"

# Legacy: DigiLocker/NSDL direct keys. Empty since we route via Setu.
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# ─── Observability ───
SENTRY_DSN="<sevalink-api project DSN from sentry.io>"
LOG_LEVEL="info"

# ─── App URLs (production) ───
API_BASE_URL="https://api.trustnear.in"
ADMIN_BASE_URL="https://admin.trustnear.in"
CUSTOMER_DEEP_LINK_SCHEME="trustnear"
PRO_DEEP_LINK_SCHEME="trustnearpro"

# ─── CORS — comma-separated whitelist of browser origins ───
# Only browser clients need this (native mobile apps don't send Origin).
# Include every URL where the admin web app + landing site is hosted.
# If unset in production, the API logs a warning and BLOCKS all browser
# clients — set this before flipping the admin web app live.
CORS_ALLOWED_ORIGINS="https://admin.trustnear.in,https://trustnear.in,https://www.trustnear.in"
