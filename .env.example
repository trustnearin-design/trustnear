# ─────────────────────────────────────────────────────────────────────
# SEVALINK — environment variables (copy to .env.local and fill in)
# NEVER commit .env / .env.local — only this .env.example template.
# ─────────────────────────────────────────────────────────────────────

# Node
NODE_ENV=development

# ─── Database (Neon Postgres) ────────────────────────────────────────
# Pooled connection — used by application at runtime
DATABASE_URL="postgresql://user:pass@host.neon.tech/sevalink?sslmode=require&pgbouncer=true"
# Direct connection — used by Prisma migrations only
DIRECT_URL="postgresql://user:pass@host.neon.tech/sevalink?sslmode=require"

# ─── Redis (Upstash) ─────────────────────────────────────────────────
REDIS_URL="rediss://default:pass@host.upstash.io:6379"

# ─── Auth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="another-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ─── SMS / OTP (MSG91) ───────────────────────────────────────────────
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="SEVAOTP"

# ─── Google Maps Platform ────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ─── Razorpay ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── AWS (S3 media + Rekognition for KYC face match) ─────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_MEDIA="sevalink-media"
CLOUDFRONT_DOMAIN=""

# ─── Firebase (FCM push notifications) ───────────────────────────────
# Path to service account JSON; do NOT commit the JSON itself
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"

# ─── Observability ───────────────────────────────────────────────────
SENTRY_DSN=""
LOG_LEVEL="debug"

# ─── App URLs ────────────────────────────────────────────────────────
API_BASE_URL="http://localhost:3000"
ADMIN_BASE_URL="http://localhost:3001"
CUSTOMER_DEEP_LINK_SCHEME="sevalink"
PRO_DEEP_LINK_SCHEME="sevalinkpro"
