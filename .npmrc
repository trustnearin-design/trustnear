# pnpm dependency strategy — stricter, more predictable than npm defaults
auto-install-peers=true
strict-peer-dependencies=false
# React Native's Metro bundler cannot traverse pnpm's symlinked (isolated) layout,
# so the workspace uses the hoisted linker — produces a flat node_modules like
# npm/yarn. This is the Expo-recommended setup for pnpm monorepos.
node-linker=hoisted
prefer-workspace-packages=true
link-workspace-packages=deep
save-workspace-protocol=rolling

# Engine strictness — fail fast on wrong Node/pnpm versions
engine-strict=true

# Network resilience
fetch-timeout=120000
fetch-retries=3

# Skip pnpm's implicit "verify-deps-before-run" check (added in pnpm 9.x)
# that runs before every pnpm command. The check writes a temp sentinel to
# the workspace parent dir, which fails with EACCES on sandboxed CI like
# AWS Amplify CodeBuild where the parent of the workspace is read-only. CI
# already runs an explicit `pnpm install --frozen-lockfile` first, so the
# implicit check is redundant.
verify-deps-before-run=false
