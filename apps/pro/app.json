{
  "expo": {
    "name": "TrustNear Pro",
    "slug": "trustnear-pro",
    "scheme": "trustnearpro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3D1F4E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.trustnear.pro"
    },
    "android": {
      "package": "in.trustnear.pro",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3D1F4E"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCyq1RycJhHbGCASXgWzR4IEueeFVi-rus"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TrustNear Pro needs your location to share live ETA with customers while you're on a job.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrustNear Pro needs gallery access to upload your profile photo and verification documents.",
          "cameraPermission": "TrustNear Pro needs camera access to capture your selfie for KYC verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:3000",
      "apiBaseUrlDevice": "http://192.168.1.19:3000",
      "router": {},
      "eas": {
        "projectId": "744d9306-e9ce-4a85-bb9a-047be091feeb"
      }
    },
    "owner": "techlenore"
  }
}
