{
  "name": "@sevalink/api",
  "version": "0.0.1",
  "private": true,
  "description": "SEVALINK backend API — Hono + Prisma + Redis + Socket.io",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env.local dist/server.js",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@sentry/node": "^9.0.0",
    "@sevalink/db": "workspace:*",
    "@sevalink/types": "workspace:*",
    "@sevalink/utils": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "expo-server-sdk": "^3.10.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sevalink/eslint-config": "workspace:*",
    "@sevalink/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
