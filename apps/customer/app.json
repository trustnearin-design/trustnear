{
  "expo": {
    "name": "SEVALINK",
    "slug": "sevalink-customer",
    "scheme": "sevalink",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.sevalink.customer"
    },
    "android": {
      "package": "in.sevalink.customer",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCyq1RycJhHbGCASXgWzR4IEueeFVi-rus"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SEVALINK to use your location to find verified pros near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:3000",
      "apiBaseUrlDevice": "http://192.168.137.1:3000",
      "router": {},
      "eas": {
        "projectId": "ae5c2d6c-25b1-4e34-8b4b-4e2fe72ccec8"
      }
    },
    "owner": "techlenore"
  }
}
