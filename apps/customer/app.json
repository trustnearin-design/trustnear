{
  "expo": {
    "name": "TrustNear",
    "slug": "sevalink-customer",
    "scheme": "sevalink",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3D1F4E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.trustnear.customer",
      "associatedDomains": ["applinks:trustnear.in", "applinks:www.trustnear.in"]
    },
    "android": {
      "package": "in.trustnear.customer",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3D1F4E"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCyq1RycJhHbGCASXgWzR4IEueeFVi-rus"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "trustnear.in",
              "pathPrefix": "/pro"
            },
            {
              "scheme": "https",
              "host": "www.trustnear.in",
              "pathPrefix": "/pro"
            },
            {
              "scheme": "https",
              "host": "trustnear.in",
              "pathPrefix": "/category"
            },
            {
              "scheme": "https",
              "host": "www.trustnear.in",
              "pathPrefix": "/category"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TrustNear to use your location to find verified pros near you."
        }
      ],
      "expo-font",
      "./plugins/withExcludeLegacySupport",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TrustNear needs your microphone to let you search services by voice.",
          "speechRecognitionPermission": "TrustNear uses speech recognition to turn your voice into a search.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://tr-92c1d37d0d36413184cb339d4053c046.ecs.ap-south-1.on.aws",
      "apiBaseUrlDevice": "https://tr-92c1d37d0d36413184cb339d4053c046.ecs.ap-south-1.on.aws",
      "router": {},
      "eas": {
        "projectId": "ae5c2d6c-25b1-4e34-8b4b-4e2fe72ccec8"
      }
    },
    "owner": "techlenore"
  }
}
